#!/usr/bin/env python3
"""agterm-archive — park a whole agterm workspace on disk and bring it back later.

`archive` writes the workspace's shape (sessions, order, names, cwds, splits) plus each
pane's claude session id and launch flags, then closes the workspace. `restore` recreates
it and resumes every claude where it left off.

Session ids come from the agterm-backup capture hook; this tool is a separate concern from
`agterm-backup restore`, which only ever deals with what is currently open.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME, ".agterm-backup")
LIVE_DIR = os.path.join(STATE_DIR, "live")
ARCHIVE_DIR = os.path.join(STATE_DIR, "archives")
SESSION_DIR = os.path.join(ARCHIVE_DIR, "sessions")
KEYMAP = os.path.join(HOME, ".config", "agterm", "keymap.conf")
WRAPPER = os.path.join(HOME, ".local", "bin", "agterm-archive")
SKILL_DIR = os.path.dirname(os.path.abspath(__file__))
BEGIN = "# >>> agterm-archive (generated by `agterm-archive install` — do not edit) >>>"
END = "# <<< agterm-archive <<<"


LOG = os.path.join(STATE_DIR, "archive.log")


def log(msg):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(LOG, "a") as fh:
            fh.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), msg))
    except Exception:
        pass


def die(msg, code=1):
    print(msg, file=sys.stderr)
    log("ERROR " + msg.replace("\n", " "))
    notify(msg.split("\n")[0])
    raise SystemExit(code)


def agtermctl(*args, check=True):
    try:
        out = subprocess.run(["agtermctl", *args], capture_output=True,
                             text=True, timeout=20)
    except Exception as exc:
        die("agtermctl failed: %s" % exc)
    if check and out.returncode != 0:
        die("agtermctl %s failed: %s" % (" ".join(args), out.stderr.strip()))
    try:
        return json.loads(out.stdout)
    except Exception:
        return out.stdout


def load_tree():
    d = agtermctl("tree", "--json")
    return d.get("result", {}).get("tree", {}) if isinstance(d, dict) else {}


def slug(name):
    return re.sub(r"[^a-zA-Z0-9._-]", "-", name).strip("-") or "workspace"


AGENTS = ("claude", "codex")
UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                     r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")


def strip_resume(argv, agent="claude"):
    """argv after the binary, minus whatever re-enters an existing session."""
    out, skip = [], False
    for i, a in enumerate(argv[1:]):
        if skip:
            skip = False
            continue
        if agent == "codex":
            if i == 0 and a in ("resume", "fork"):
                continue
            if a == "--last" or UUID_RE.match(a):
                continue
            out.append(a)
            continue
        if a in ("--resume", "-r"):
            skip = True
            continue
        if a in ("--continue", "-c", "--fork-session"):
            continue
        out.append(a)
    return out


def resume_cmd(agent, sid, flags):
    if agent == "codex":
        return " ".join(["codex", "resume", sid] + list(flags))
    return " ".join(["claude", "--resume", sid] + list(flags))


def resume_id(argv):
    """The session id already on the command line: `claude --resume <id>` or
    `codex resume|fork <id>`."""
    for i, a in enumerate(argv):
        if a in ("--resume", "-r", "resume", "fork") and i + 1 < len(argv):
            cand = argv[i + 1]
            if UUID_RE.match(cand):
                return cand
    return None


def live_id(pane_id, role, agent):
    """The hook's record for this pane, only if the same agent wrote it."""
    try:
        with open(os.path.join(LIVE_DIR, "%s-%s.json" % (pane_id.upper(), role))) as fh:
            rec = json.load(fh)
    except Exception:
        return None
    if (rec.get("agent") or "claude") != agent:
        return None
    return rec.get("claude_session_id")


def pane_record(pane_id, role, argv, cwd):
    agent = os.path.basename(argv[0]) if argv else ""
    is_agent = agent in AGENTS
    return {
        "role": role,
        "cwd": cwd,
        "agent": agent if is_agent else None,
        "is_claude": is_agent,          # kept for archives written by older versions
        "claude_session_id": (live_id(pane_id, role, agent) or resume_id(argv)) if is_agent else None,
        "flags": strip_resume(argv, agent) if is_agent else [],
    }


def snap_session(s):
    """One session's shape plus its panes' agent ids — the unit both kinds archive."""
    pid = (s.get("id") or "").upper()
    rec = {
        "name": s.get("name"),
        "title": s.get("title"),
        "cwd": s.get("cwd") or HOME,
        "flagged": bool(s.get("flagged")),
        "split": bool(s.get("split")),
        "split_axis": s.get("splitAxis") or "vertical",
        "split_ratio": s.get("splitRatio"),
        "panes": [pane_record(pid, "left", s.get("foreground") or [], s.get("cwd") or HOME)],
    }
    if s.get("split"):
        rec["panes"].append(pane_record(pid, "right", s.get("splitForeground") or [],
                                        s.get("splitCwd") or s.get("cwd") or HOME))
    return rec


def restore_session(s, wsname, no_boot=False, after=None):
    """Recreate one archived session in `wsname` and boot its agents."""
    cmd = ["session", "new", "--workspace-name", wsname, "--create-workspace",
           "--cwd", s["cwd"], "--name", s.get("name") or "", "--no-select", "--json"]
    if after:
        cmd = ["session", "new", "--after", after, "--cwd", s["cwd"],
               "--name", s.get("name") or "", "--no-select", "--json"]
    created = agtermctl(*cmd)
    sid = created.get("result", {}).get("id")
    if not sid:
        print("  FAILED to create %r" % s.get("name"))
        return None
    print("  + %s" % (s.get("name") or sid[:8]))

    if s.get("split"):
        agtermctl("session", "split", "visibility", "on",
                  "--axis", s.get("split_axis") or "vertical", "--target", sid)
        if s.get("split_ratio"):
            agtermctl("session", "resize", "--split-ratio",
                      "%.3f" % float(s["split_ratio"]), "--target", sid)

    for p in s["panes"]:
        if no_boot or not p.get("claude_session_id"):
            continue
        line = resume_cmd(p.get("agent") or "claude", p["claude_session_id"],
                          p.get("flags", []))
        if p["role"] == "right" and p.get("cwd") and p["cwd"] != s["cwd"]:
            line = "cd %s && %s" % (p["cwd"], line)
        agtermctl("session", "type", "--target", sid,
                  "--pane", "right" if p["role"] == "right" else "left", line + "\n")
        print("      %-8s %s" % (p["role"], line))
    return sid


def find_session(tree, ref):
    """(workspace, session) for a session id/prefix, or the active session."""
    for ws in tree.get("workspaces", []):
        for s in ws.get("sessions", []):
            sid = (s.get("id") or "").upper()
            if ref and (sid.startswith(ref.upper()) or s.get("name") == ref):
                return ws, s
            if not ref and s.get("active"):
                return ws, s
    return None, None


def find_workspace(tree, ref):
    for ws in tree.get("workspaces", []):
        if ref is None and ws.get("active"):
            return ws
        if ref and (ws.get("name") == ref or (ws.get("id") or "").upper().startswith(ref.upper())):
            return ws
    return None


def archive_path(name):
    return os.path.join(ARCHIVE_DIR, slug(name) + ".json")


def session_path(wsname, name):
    return os.path.join(SESSION_DIR, "%s--%s.json" % (slug(wsname or "?"), slug(name or "session")))


def iter_archives():
    """(kind, label, path, data) for every archive on disk."""
    for d, kind in ((ARCHIVE_DIR, "workspace"), (SESSION_DIR, "session")):
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".json"):
                continue
            path = os.path.join(d, fn)
            try:
                with open(path) as fh:
                    data = json.load(fh)
            except Exception:
                continue
            if kind == "workspace":
                label = data.get("workspace") or fn[:-5]
            else:
                label = "%s / %s" % (data.get("workspace") or "?",
                                     data.get("session", {}).get("name") or fn[:-5])
            yield kind, label, path, data


def resolve_archive(name):
    """Find an archive by workspace name, session name, or 'workspace / session'."""
    hits = [(k, l, p, d) for k, l, p, d in iter_archives()
            if l == name or (k == "session" and (d.get("session", {}).get("name") == name))]
    if len(hits) > 1:
        die("%r matches %d archives — use the full label:\n  %s"
            % (name, len(hits), "\n  ".join(h[1] for h in hits)))
    return hits[0] if hits else (None, None, None, None)


# --------------------------------------------------------------------------- commands

def cmd_archive(args):
    tree = load_tree()
    ws = find_workspace(tree, args.workspace)
    if not ws:
        die("workspace %r not found" % (args.workspace or "active"))
    if not args.keep and (ws.get("id") or "").upper() == (os.environ.get("AGTERM_WORKSPACE_ID") or "").upper():
        die("that is the workspace you are running in — closing it would kill this session.\n"
            "Run it from elsewhere, or pass --keep to snapshot without closing.")

    sessions = [snap_session(s) for s in ws.get("sessions", [])]

    snap = {
        "kind": "workspace",
        "workspace": ws.get("name"),
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "sessions": sessions,
    }
    os.makedirs(ARCHIVE_DIR, exist_ok=True)
    path = archive_path(ws.get("name") or "workspace")
    if os.path.exists(path) and not args.force:
        die("%s already archived (%s) — pass --force to overwrite" % (ws.get("name"), path))
    with open(path, "w") as fh:
        json.dump(snap, fh, indent=1)

    claudes = sum(1 for s in sessions for p in s["panes"] if p["claude_session_id"])
    missing = sum(1 for s in sessions for p in s["panes"]
                  if p.get("agent") and not p["claude_session_id"])
    print("archived %r: %d session(s), %d agent(s) resumable" %
          (ws.get("name"), len(sessions), claudes))
    if missing:
        print("  WARNING: %d agent pane(s) had no captured id and will come back as a "
              "plain shell (agterm-backup hook not installed, or that session never acted)"
              % missing)
    print("  file: %s" % path)

    if args.keep:
        print("  --keep: workspace left open")
        return 0
    agtermctl("workspace", "delete", "--target", ws.get("id"))
    log("archived %r (%d sessions, %d claudes)" % (ws.get("name"), len(sessions), claudes))
    notify("archived %s — %d session(s)" % (ws.get("name"), len(sessions)))
    print("  workspace closed. Bring it back with: agterm-archive restore %r" % ws.get("name"))
    return 0


def cmd_archive_session(args):
    tree = load_tree()
    ws, sess = find_session(tree, args.session)
    if not sess:
        die("session %r not found" % (args.session or "active"))
    sid = (sess.get("id") or "").upper()
    if not args.keep and sid == (os.environ.get("AGTERM_SESSION_ID") or "").upper():
        die("that is the session you are running in — closing it would kill this "
            "process. Run it from elsewhere, or pass --keep to snapshot without closing.")

    snap = {
        "kind": "session",
        "workspace": ws.get("name"),
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "session": snap_session(sess),
    }
    os.makedirs(SESSION_DIR, exist_ok=True)
    path = session_path(ws.get("name"), sess.get("name"))
    if os.path.exists(path) and not args.force:
        die("%s / %s already archived (%s) — pass --force to overwrite"
            % (ws.get("name"), sess.get("name"), path))
    with open(path, "w") as fh:
        json.dump(snap, fh, indent=1)

    agents = sum(1 for p in snap["session"]["panes"] if p.get("claude_session_id"))
    missing = sum(1 for p in snap["session"]["panes"]
                  if p.get("agent") and not p.get("claude_session_id"))
    print("archived session %r from %r (%d agent(s) resumable)"
          % (sess.get("name"), ws.get("name"), agents))
    if missing:
        print("  WARNING: %d agent pane(s) had no captured id and will come back as a "
              "plain shell" % missing)
    print("  file: %s" % path)
    if args.keep:
        print("  --keep: session left open")
        return 0
    agtermctl("session", "close", "--target", sid)
    log("archived session %r / %r" % (ws.get("name"), sess.get("name")))
    notify("archived session %s" % (sess.get("name") or sid[:8]))
    print("  session closed. Bring it back with: agterm-archive restore %r"
          % (sess.get("name") or ""))
    return 0


def cmd_list(args):
    rows = []
    for kind, label, path, d in iter_archives():
        sessions = d["sessions"] if kind == "workspace" else [d["session"]]
        agents = sum(1 for s in sessions for p in s["panes"] if p.get("claude_session_id"))
        rows.append((kind, label, d.get("ts", "?"), len(sessions), agents))
    if not rows:
        print("no archives yet")
        return 0
    print("%-10s %-34s %-22s %8s %7s"
          % ("KIND", "NAME", "ARCHIVED", "SESSIONS", "AGENTS"))
    for kind, label, ts, n, c in rows:
        print("%-10s %-34s %-22s %8d %7d" % (kind, label[:34], ts, n, c))
    return 0


def cmd_restore(args):
    kind, label, path, snap = resolve_archive(args.name)
    if not path:
        die("no archive named %r (see 'agterm-archive list')" % args.name)
    wsname = snap.get("workspace") or args.name

    if kind == "session":
        sess = snap["session"]
        print("restoring session %r into %r%s"
              % (sess.get("name"), wsname, " (--no-boot)" if args.no_boot else ""))
        restore_session(sess, wsname, no_boot=args.no_boot)
        log("restored session %r / %r" % (wsname, sess.get("name")))
        print("\nDone. The session is live again, so agterm-backup covers it from here on.")
        if not args.keep:
            os.remove(path)
            print("Archive consumed (%s). Use --keep to restore without removing it." % path)
        return 0

    if find_workspace(load_tree(), wsname) and not args.force:
        die("workspace %r is already open — close it first, or pass --force to add the "
            "sessions to it" % wsname)

    print("restoring %r: %d session(s)%s" %
          (wsname, len(snap["sessions"]), "" if not args.no_boot else " (--no-boot)"))
    for s in snap["sessions"]:
        restore_session(s, wsname, no_boot=args.no_boot)

    log("restored %r (%d sessions)" % (wsname, len(snap["sessions"])))
    print("\nDone. The restored sessions are live again, so agterm-backup covers them "
          "from here on.")
    if not args.keep:
        os.remove(path)
        print("Archive consumed (%s). Use --keep to restore without removing it." % path)
    return 0


def notify(text):
    agtermctl("notify", text, "--title", "agterm-archive", check=False)


def cmd_pick_restore(args):
    """Palette entry: pick an archive in the native picker, then restore it."""
    entries = [(k, l) for k, l, _p, _d in iter_archives()]
    names = ["%s: %s" % (k, l) for k, l in entries]
    if not names:
        notify("nothing archived")
        return 0
    out = subprocess.run(["agtermctl", "pick", "open", "--prompt", "restore workspace",
                          "--no-block", "--json"],
                         input="\n".join(names), capture_output=True, text=True, timeout=30)
    try:
        pid = json.loads(out.stdout)["id"]
    except Exception:
        die("could not open the picker: %s%s" % (out.stdout.strip(), out.stderr.strip()))
    log("picker %s opened with %d choice(s)" % (pid, len(names)))

    picked = None
    for _ in range(600):                             # 5 min at 0.5s
        time.sleep(0.5)
        res = agtermctl("pick", "result", pid, "--json", check=False)
        if not isinstance(res, dict):
            continue
        state = res.get("result")
        if state == "pending":
            continue
        if state == "cancelled":
            log("picker cancelled")
            return 0
        # {"result":"picked","id":...,"label":...,"index":N} / {"result":"custom","query":...}
        idx = res.get("index")
        if isinstance(idx, int) and 0 <= idx < len(names):
            picked = names[idx]
        else:
            picked = res.get("label") or res.get("id") or res.get("query")
        break
    if not isinstance(picked, str) or not picked:
        log("picker gave nothing usable")
        return 0
    log("picked %r" % picked)
    # the picker shows "kind: label"; restore wants the label
    picked = picked.split(": ", 1)[1] if ": " in picked else picked
    args.name, args.no_boot, args.keep, args.force = picked, False, False, False
    rc = cmd_restore(args)
    notify("restored %s" % picked)
    return rc


def cmd_install(args):
    os.makedirs(os.path.dirname(WRAPPER), exist_ok=True)
    with open(WRAPPER, "w") as fh:
        fh.write(
            "#!/bin/sh\n"
            "# generated by `agterm-archive install` — do not edit\n"
            'd=$(ls -dt "$HOME"/.claude/plugins/cache/*/bos/*/skills/agterm-archive '
            '2>/dev/null | head -1)\n'
            '[ -n "$d" ] && [ -f "$d/agterm-archive" ] || d=%s\n'
            'exec /usr/bin/python3 "$d/agterm-archive" "$@"\n' % json.dumps(SKILL_DIR)
        )
    os.chmod(WRAPPER, 0o755)

    w = WRAPPER.replace(HOME, "$HOME")
    arch_chord = "" if args.no_chord else (args.archive_chord or "cmd+ctrl+a>a") + " "
    sess_chord = "" if args.no_chord else (args.session_chord or "cmd+ctrl+a>s") + " "
    rest_chord = "" if args.no_chord else (args.restore_chord or "cmd+ctrl+a>r") + " "
    block = (
        "%s\n"
        'command "Archive workspace" %s%s archive "$AGT_WORKSPACE_ID"\n'
        'command "Archive session" %s%s session "$AGT_SESSION_ID"\n'
        'command "Restore archive" %s%s pick-restore\n'
        "%s\n" % (BEGIN, arch_chord, w, sess_chord, w, rest_chord, w, END)
    )
    try:
        with open(KEYMAP) as fh:
            conf = fh.read()
    except FileNotFoundError:
        conf = ""
    if BEGIN in conf and END in conf:
        head, rest = conf.split(BEGIN, 1)
        conf = head + block + rest.split(END, 1)[1].lstrip("\n")
    else:
        conf = conf.rstrip("\n") + "\n\n" + block
    os.makedirs(os.path.dirname(KEYMAP), exist_ok=True)
    with open(KEYMAP, "w") as fh:
        fh.write(conf)
    agtermctl("keymap", "reload")
    print("wrapper:  %s" % WRAPPER)
    print("keymap:   %s  (block updated, keymap reloaded)" % KEYMAP)
    print('palette:  "Archive workspace" %s / "Archive session" %s / "Restore archive" %s'
          % (arch_chord.strip() or "(palette only)", sess_chord.strip() or "(palette only)",
             rest_chord.strip() or "(palette only)"))
    return 0


def cmd_uninstall(args):
    try:
        with open(KEYMAP) as fh:
            conf = fh.read()
    except FileNotFoundError:
        conf = ""
    if BEGIN in conf and END in conf:
        head, rest = conf.split(BEGIN, 1)
        with open(KEYMAP, "w") as fh:
            fh.write(head.rstrip("\n") + "\n" + rest.split(END, 1)[1].lstrip("\n"))
        agtermctl("keymap", "reload")
        print("removed the keymap block, keymap reloaded")
    else:
        print("no keymap block to remove")
    if os.path.exists(WRAPPER):
        os.remove(WRAPPER)
        print("removed %s" % WRAPPER)
    return 0


def cmd_drop(args):
    kind, label, path, _ = resolve_archive(args.name)
    if not path:
        die("no archive named %r" % args.name)
    os.remove(path)
    print("dropped %s archive %s (%s)" % (kind, label, path))
    return 0


def main():
    ap = argparse.ArgumentParser(prog="agterm-archive",
                                 description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("archive", help="snapshot a workspace and close it")
    a.add_argument("workspace", nargs="?", help="name or id (default: active workspace)")
    a.add_argument("--keep", action="store_true", help="snapshot without closing")
    a.add_argument("--force", action="store_true", help="overwrite an existing archive")
    a.set_defaults(fn=cmd_archive)

    ss = sub.add_parser("session", help="snapshot a single session and close it")
    ss.add_argument("session", nargs="?", help="session id/prefix or name (default: active)")
    ss.add_argument("--keep", action="store_true", help="snapshot without closing")
    ss.add_argument("--force", action="store_true", help="overwrite an existing archive")
    ss.set_defaults(fn=cmd_archive_session)

    l = sub.add_parser("list", help="list archived workspaces and sessions")
    l.set_defaults(fn=cmd_list)

    r = sub.add_parser("restore", help="recreate an archived workspace or session")
    r.add_argument("name")
    r.add_argument("--no-boot", action="store_true", help="recreate shells, skip claude")
    r.add_argument("--keep", action="store_true", help="keep the archive file after restoring")
    r.add_argument("--force", action="store_true", help="restore even if the workspace is open")
    r.set_defaults(fn=cmd_restore)

    pr = sub.add_parser("pick-restore", help="pick an archive in agterm's picker, restore it")
    pr.set_defaults(fn=cmd_pick_restore)

    i = sub.add_parser("install", help="wire the archive/restore custom commands")
    i.add_argument("--archive-chord", help="chord for Archive workspace (default: cmd+ctrl+a>a)")
    i.add_argument("--session-chord", help="chord for Archive session (default: cmd+ctrl+a>s)")
    i.add_argument("--restore-chord", help="chord for Restore workspace (default: cmd+ctrl+a>r)")
    i.add_argument("--no-chord", action="store_true", help="palette-only, no key bindings")
    i.set_defaults(fn=cmd_install)

    u = sub.add_parser("uninstall", help="remove the custom commands and wrapper")
    u.set_defaults(fn=cmd_uninstall)

    d = sub.add_parser("drop", help="delete an archive")
    d.add_argument("name")
    d.set_defaults(fn=cmd_drop)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main())
