#!/usr/bin/env python3
"""agterm-fork — branch the agent running in an agterm pane into a sibling session.

Works for claude (`--resume <id> --fork-session`) and codex (`codex fork <id>`): the
fork replays the same conversation under a NEW session id, inherits the parent's launch
flags, lands in the same workspace right after the source session, and stops at its
prompt.

Session ids come from the agterm-backup capture hook
(~/.agterm-backup/live/<pane>-<role>.json); a pane whose claude was itself resumed
also carries the id in its argv, which is used as a fallback.
"""
import argparse
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
LIVE_DIR = os.path.join(HOME, ".agterm-backup", "live")
KEYMAP = os.path.join(HOME, ".config", "agterm", "keymap.conf")
WRAPPER = os.path.join(HOME, ".local", "bin", "agterm-fork")
SKILL_DIR = os.path.dirname(os.path.abspath(__file__))
BEGIN = "# >>> agterm-fork (generated by `agterm-fork install` — do not edit) >>>"
END = "# <<< agterm-fork <<<"


def agtermctl(*args):
    try:
        out = subprocess.run(["agtermctl", *args], capture_output=True,
                             text=True, timeout=15)
    except Exception as exc:
        die("agtermctl failed: %s" % exc)
    if out.returncode != 0:
        die("agtermctl %s failed: %s" % (" ".join(args), out.stderr.strip()))
    try:
        return json.loads(out.stdout)
    except Exception:
        return out.stdout


def die(msg, code=1):
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def load_tree():
    d = agtermctl("tree", "--json")
    return d.get("result", {}).get("tree", {}) if isinstance(d, dict) else {}


def find_session(tree, pane_id):
    for ws in tree.get("workspaces", []):
        for s in ws.get("sessions", []):
            if (s.get("id") or "").upper() == pane_id.upper():
                return ws, s
    return None, None


AGENTS = ("claude", "codex")
UUID_RE = __import__("re").compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                                   r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")


def strip_resume(argv, agent="claude"):
    """argv after the binary, minus whatever re-enters an existing session."""
    out, skip = [], False
    for i, a in enumerate(argv[1:]):
        if skip:
            skip = False
            continue
        if agent == "codex":
            if i == 0 and a in ("resume", "fork"):
                continue
            if a == "--last" or UUID_RE.match(a):
                continue
            out.append(a)
            continue
        if a in ("--resume", "-r"):
            skip = True
            continue
        if a in ("--continue", "-c", "--fork-session"):
            continue
        out.append(a)
    return _dedupe(out)


def _dedupe(flags):
    """A pane can carry the same flag twice (a hand-typed resume on top of the original
    launch); do not pass that on."""
    seen, out = set(), []
    for f in flags:
        if f.startswith("-") and f in seen:
            continue
        seen.add(f)
        out.append(f)
    return out


def fork_cmd(agent, sid, flags):
    """The shell line that opens a divergent copy of session `sid`."""
    if agent == "codex":
        return " ".join(["codex", "fork", sid] + list(flags))
    return " ".join(["claude", "--resume", sid, "--fork-session"] + list(flags))


def resume_id(argv):
    """The session id already on the command line: `claude --resume <id>` or
    `codex resume|fork <id>`."""
    for i, a in enumerate(argv):
        if a in ("--resume", "-r", "resume", "fork") and i + 1 < len(argv):
            cand = argv[i + 1]
            if UUID_RE.match(cand):
                return cand
    return None


def live_id(pane_id, role, agent):
    """The hook's record for this pane, only if the same agent wrote it — a pane that
    ran claude yesterday and codex today must not fork the claude."""
    path = os.path.join(LIVE_DIR, "%s-%s.json" % (pane_id.upper(), role))
    try:
        with open(path) as fh:
            rec = json.load(fh)
    except Exception:
        return None
    if (rec.get("agent") or "claude") != agent:
        return None
    return rec.get("claude_session_id")


def _answer_resume_prompt(sid, timeout=240, choice="2"):
    """A resumed claude asks full-session-vs-summary before it reaches its prompt.
    Boot takes up to a minute, so poll instead of sleeping blind."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(3)
        out = subprocess.run(["agtermctl", "session", "text", "--target", sid],
                             capture_output=True, text=True)
        text = out.stdout if out.returncode == 0 else ""
        if "Resume full session as-is" in text and "Enter to confirm" in text:
            agtermctl("session", "type", "--target", sid, choice + "\n")
            print("  answered the resume prompt with %r" % choice)
            return True
        if "esc to interrupt" in text or "\u276f " in text:
            return False
    return False


def cmd_fork(args):
    pane_id = args.pane or os.environ.get("AGTERM_SESSION_ID")
    role = args.role or os.environ.get("AGTERM_PANE") or "left"
    if not pane_id:
        die("no pane id: pass one, or run inside agterm")

    tree = load_tree()
    ws, s = find_session(tree, pane_id)
    if not s:
        die("pane %s not found in the agterm tree" % pane_id)

    if role == "right":
        argv = s.get("splitForeground") or []
        cwd = s.get("splitCwd") or s.get("cwd") or HOME
    else:
        argv = s.get("foreground") or []
        cwd = s.get("cwd") or HOME

    agent = os.path.basename(argv[0]) if argv else ""
    if agent not in AGENTS:
        die("no claude or codex running in %s/%s — nothing to fork" % (pane_id[:8], role))

    sid = live_id(pane_id, role, agent) or resume_id(argv)
    if not sid:
        die("no %s session id for this pane.\n" % agent +
            "The agterm-backup capture hook is what records it — run "
            "'agterm-backup install', then act once in that session and retry.")

    flags = strip_resume(argv, agent)
    name = args.name or ("fork: " + (s.get("name") or "session"))

    if args.dry_run:
        print("would fork %s/%s (%s, workspace %s)" % (s.get("name") or pane_id[:8], role, agent,
                                                   ws.get("name") or "?"))
        print("  cwd:  %s" % cwd)
        print("  boot: %s" % fork_cmd(agent, sid, flags))
        return 0

    created = agtermctl("session", "new", "--after", pane_id, "--cwd", cwd,
                        "--name", name, "--no-select", "--json")
    new_id = created.get("result", {}).get("id")
    if not new_id:
        die("could not create the session: %s" % created)

    cmd = fork_cmd(agent, sid, flags)
    agtermctl("session", "type", "--target", new_id, cmd + "\n")
    if agent == "claude" and not args.no_answer:
        _answer_resume_prompt(new_id, args.answer_timeout, args.answer_choice)

    print("forked %s/%s -> %s" % (s.get("name") or pane_id[:8], role, name))
    print("  workspace: %s" % (ws.get("name") or "?"))
    print("  parent %s session: %s" % (agent, sid))
    print("  booting: %s" % cmd)
    print("\nThe fork wakes up with the full history and waits at its prompt — "
          "open it and tell it what to do.")
    return 0


def cmd_install(args):
    os.makedirs(os.path.dirname(WRAPPER), exist_ok=True)
    # the plugin cache path carries a commit sha and changes on every update, so the
    # wrapper resolves the newest installed copy at call time and only falls back to
    # the directory install ran from.
    with open(WRAPPER, "w") as fh:
        fh.write(
            "#!/bin/sh\n"
            "# generated by `agterm-fork install` — do not edit\n"
            'd=$(ls -dt "$HOME"/.claude/plugins/cache/*/bos/*/skills/agterm-fork '
            '2>/dev/null | head -1)\n'
            '[ -n "$d" ] && [ -f "$d/agterm-fork" ] || d=%s\n'
            'exec /usr/bin/python3 "$d/agterm-fork" "$@"\n' % json.dumps(SKILL_DIR)
        )
    os.chmod(WRAPPER, 0o755)

    chord = "" if args.no_chord else (args.chord or "cmd+ctrl+a>f") + " "
    block = "%s\ncommand \"Fork session\" %s%s \"$AGT_SESSION_ID\" \"$AGT_PANE\"\n%s\n" % (
        BEGIN, chord, WRAPPER.replace(HOME, "$HOME"), END)
    try:
        with open(KEYMAP) as fh:
            conf = fh.read()
    except FileNotFoundError:
        conf = ""
    if BEGIN in conf and END in conf:
        head, rest = conf.split(BEGIN, 1)
        conf = head + block + rest.split(END, 1)[1].lstrip("\n")
    else:
        conf = conf.rstrip("\n") + "\n\n" + block
    os.makedirs(os.path.dirname(KEYMAP), exist_ok=True)
    with open(KEYMAP, "w") as fh:
        fh.write(conf)

    agtermctl("keymap", "reload")
    print("wrapper:  %s" % WRAPPER)
    print("keymap:   %s  (block updated, keymap reloaded)" % KEYMAP)
    print('palette:  Ctrl-Shift-O -> "Fork session"%s' %
          ("" if args.no_chord else "   (chord: %s)" % (args.chord or "cmd+ctrl+a>f")))
    return 0


def cmd_uninstall(args):
    try:
        with open(KEYMAP) as fh:
            conf = fh.read()
    except FileNotFoundError:
        conf = ""
    if BEGIN in conf and END in conf:
        head, rest = conf.split(BEGIN, 1)
        with open(KEYMAP, "w") as fh:
            fh.write(head.rstrip("\n") + "\n" + rest.split(END, 1)[1].lstrip("\n"))
        agtermctl("keymap", "reload")
        print("removed the keymap block, keymap reloaded")
    else:
        print("no keymap block to remove")
    if os.path.exists(WRAPPER):
        os.remove(WRAPPER)
        print("removed %s" % WRAPPER)
    return 0


def main():
    ap = argparse.ArgumentParser(prog="agterm-fork", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")

    f = sub.add_parser("fork", help="fork a pane's claude (default command)")
    f.add_argument("pane", nargs="?", help="agterm session id (default: current)")
    f.add_argument("role", nargs="?", help="pane role: left|right (default: current)")
    f.add_argument("--name", help="name for the new session")
    f.add_argument("--dry-run", action="store_true", help="print the plan, create nothing")
    f.add_argument("--no-answer", action="store_true",
                   help="leave claude's resume prompt for you to answer")
    f.add_argument("--answer-choice", default="2",
                   help="2 = resume full session as-is (default), 1 = from summary")
    f.add_argument("--answer-timeout", type=int, default=240)
    f.set_defaults(fn=cmd_fork)

    i = sub.add_parser("install", help='wire the "Fork session" custom command')
    i.add_argument("--chord", help="key chord for the palette entry (default: cmd+ctrl+a>f)")
    i.add_argument("--no-chord", action="store_true", help="palette-only, no key binding")
    i.set_defaults(fn=cmd_install)

    u = sub.add_parser("uninstall", help="remove the custom command and wrapper")
    u.set_defaults(fn=cmd_uninstall)

    argv = sys.argv[1:]
    if argv and argv[0] not in ("fork", "install", "uninstall", "-h", "--help"):
        argv = ["fork"] + argv          # `agterm-fork <pane> <role>` shorthand
    args = ap.parse_args(argv or ["fork"])
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main())
