#!/usr/bin/env python3
"""agterm-ask — ask the user a question as a rich HTML page in an agterm overlay.

Usage: agterm-ask BODY.html [--title T] [--follow]

BODY.html is an HTML fragment: option sections with <input name="choice">, plus any
explanation, charts, mermaid, code. It is wrapped in a themed page with a form, served on
127.0.0.1 and opened over $AGTERM_SESSION_ID. Blocks until the user answers or closes it.

stdout: JSON of the submitted form, e.g. {"choice": ["b"], "note": "..."}
exit:   0 answered (Answer, or closed after picking) · 3 dismissed (closed with nothing picked) · 2 error
"""
import argparse
import html
import http.server
import json
import os
import shutil
import subprocess
import sys
import threading
import time
import urllib.parse

BUNDLED_AGTERMCTL = "/Applications/agterm.app/Contents/MacOS/agtermctl"
AGTERMCTL = next((c for c in (shutil.which("agtermctl"), BUNDLED_AGTERMCTL)
                  if c and os.access(c, os.X_OK)), "agtermctl")

PAGE = """<!doctype html>
<html><head><meta charset="utf-8"><title>{title}</title>
<style>
body {{ background: var(--agterm-background, Canvas); color: var(--agterm-foreground, CanvasText);
  font: 15px/1.55 -apple-system, system-ui, sans-serif; margin: 0; }}
main {{ max-width: 980px; margin: 0 auto; padding: 24px 28px 120px;
  --fg: var(--agterm-foreground, CanvasText); --accent: var(--agterm-color-4, #4a8);
  --ok: var(--agterm-color-2, green); --bad: var(--agterm-color-1, red); --warn: var(--agterm-color-3, orange); }}
h1 {{ font-size: 22px; margin: 0 0 12px; }}
a {{ color: var(--accent); }}
code, pre {{ font: 13px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; }}
pre, .card {{ background: color-mix(in srgb, var(--fg) 6%, transparent);
  border: 1px solid color-mix(in srgb, var(--fg) 14%, transparent); border-radius: 8px; }}
pre {{ padding: 10px 12px; overflow-x: auto; }}
:not(pre) > code {{ background: color-mix(in srgb, var(--fg) 9%, transparent); padding: 1px 5px; border-radius: 4px; }}
table {{ border-collapse: collapse; margin: 8px 0; }}
th, td {{ border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent); padding: 5px 10px; text-align: left; vertical-align: top; }}
.opt {{ display: block; padding: 14px 18px; margin: 14px 0; border-radius: 10px; cursor: pointer;
  border: 2px solid color-mix(in srgb, var(--fg) 14%, transparent);
  background: color-mix(in srgb, var(--fg) 4%, transparent); }}
.opt:has(input:checked) {{ border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }}
.opt > h2, .opt > h3 {{ margin: 0 0 6px; display: flex; gap: 10px; align-items: center; }}
.opt input {{ transform: scale(1.3); }}
.rec {{ font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 99px; color: var(--agterm-background, Canvas); background: var(--ok); }}
.pro {{ color: var(--ok); }} .con {{ color: var(--bad); }}
.mermaid {{ background: color-mix(in srgb, var(--fg) 4%, transparent); border-radius: 8px; padding: 8px; }}
footer {{ position: fixed; bottom: 0; left: 0; right: 0; padding: 12px 28px; display: flex; gap: 12px;
  background: var(--agterm-background, Canvas); border-top: 1px solid color-mix(in srgb, var(--fg) 14%, transparent); }}
footer textarea {{ flex: 1; min-height: 38px; height: 38px; resize: vertical; color: inherit; font: inherit;
  background: color-mix(in srgb, var(--fg) 6%, transparent); border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
  border-radius: 8px; padding: 7px 10px; }}
footer button {{ font: inherit; font-weight: 600; padding: 0 22px; border: 0; border-radius: 8px; cursor: pointer;
  color: var(--agterm-background, Canvas); background: var(--accent); }}
</style></head><body>
<form method="post" action="/answer"><main>
<h1>{title}</h1>
{body}
</main>
<footer><textarea name="note" placeholder="Comment, or your own option (optional)"></textarea>
<button type="submit">Answer</button></footer>
</form>
<script type="module">
// the form is saved as a draft on load and every change, so closing the page after picking still answers
const form = document.querySelector('form');
const save = () => fetch('/draft', {{ method: 'POST', body: new URLSearchParams(new FormData(form)) }});
form.addEventListener('change', save);
form.addEventListener('input', save);
save();  // a pre-checked default counts too
if (document.querySelector('.mermaid')) {{
  const bg = getComputedStyle(document.body).backgroundColor.match(/\\d+/g) || [255, 255, 255];
  const dark = (0.299 * bg[0] + 0.587 * bg[1] + 0.114 * bg[2]) < 128;
  const {{ default: mermaid }} = await import('https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs');
  mermaid.initialize({{ startOnLoad: false, theme: dark ? 'dark' : 'default' }});
  await mermaid.run();
}}
</script>
</body></html>"""

DONE = ("<!doctype html><meta charset=utf-8><body style='background:var(--agterm-background,Canvas);"
        "color:var(--agterm-foreground,CanvasText);font:16px system-ui;padding:40px'>Answer sent.")


def make_server(page):
    """Serve `page` on 127.0.0.1; the first POST /answer lands in server.answer."""
    class Handler(http.server.BaseHTTPRequestHandler):
        def _send(self, body, code=200):
            data = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            self._send(DONE if server.answer is not None else page)

        def do_POST(self):
            if self.path not in ("/answer", "/draft"):
                return self._send("not found", 404)
            raw = self.rfile.read(int(self.headers.get("Content-Length") or 0)).decode()
            form = urllib.parse.parse_qs(raw, keep_blank_values=True)
            answer = {k: (v if k == "choice" else v[-1]) for k, v in form.items()}
            answer.setdefault("choice", [])
            if self.path == "/draft":
                server.draft = answer
                return self._send("ok")
            if server.answer is None:
                server.answer = answer
            self._send(DONE)

        def log_message(self, *_):
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    server.answer = server.draft = None
    return server


def ctl(*args):
    sock = ("--socket", os.environ["AGTERM_SOCKET"]) if os.environ.get("AGTERM_SOCKET") else ()
    return subprocess.run([AGTERMCTL, *args, *sock], capture_output=True, text=True)


def overlay_open(url):
    """Is our page still in an overlay? Any lookup failure counts as open, so a flaky
    socket never turns into a fake dismissal."""
    r = ctl("tree", "--json", "--window", os.environ.get("AGTERM_WINDOW_ID", "active"))
    if r.returncode != 0:
        return True
    return url in json.dumps(json.loads(r.stdout))  # raw output escapes "/" as "\/"


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("body")
    ap.add_argument("--title", default="Choose an option")
    ap.add_argument("--follow", action="store_true", help="switch the user to this session now")
    a = ap.parse_args()

    sid = os.environ.get("AGTERM_SESSION_ID")
    if not sid:
        sys.exit("agterm-ask: not inside agterm (AGTERM_SESSION_ID unset); use AskUserQuestion")
    with open(a.body, encoding="utf-8") as f:
        page = PAGE.format(title=html.escape(a.title), body=f.read())

    server = make_server(page)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    url = "http://127.0.0.1:%d/" % server.server_address[1]
    r = ctl("session", "overlay", "open", "--url", url, "--js", "--target", sid,
            *(["--follow"] if a.follow else []))
    if r.returncode != 0:
        print("agterm-ask: overlay open failed: %s" % (r.stderr or r.stdout).strip(), file=sys.stderr)
        sys.exit(2)

    time.sleep(2)  # let the overlay register before the first liveness check
    while server.answer is None:
        if not overlay_open(url):
            d = server.draft
            if d and (d["choice"] or d.get("note", "").strip()):
                print(json.dumps(d, ensure_ascii=False))  # picked, then closed without Answer
                return
            print(json.dumps({"dismissed": True}))
            sys.exit(3)
        time.sleep(1)
    time.sleep(0.5)  # let the "Answer sent" page render
    ctl("session", "overlay", "close", "--target", sid)
    print(json.dumps(server.answer, ensure_ascii=False))


if __name__ == "__main__":
    main()
