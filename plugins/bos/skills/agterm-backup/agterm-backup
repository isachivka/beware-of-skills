#!/usr/bin/env python3
"""agterm-backup — bring your running sessions (especially claude, resumed) back
after an agterm/macOS restart.

Foundation (verified against agterm source):
- agterm rebuilds the session tree on cold launch keyed by the PERSISTED session
  UUIDs (AppStore.restore(from:)), so a pane's AGTERM_SESSION_ID is STABLE across a
  restart. That id is our join key.
- The "Restore running commands on restart" setting only gates whether a pane also
  re-runs its captured command; the tree itself (workspaces/sessions/cwds, as plain
  shells) is always restored. So after a restart panes sit at a shell prompt and we
  type the resume command into them.

Two capture paths:
- DURABLE (recommended): a Claude Code hook (capture.py) records
  AGTERM_SESSION_ID -> claude session_id on every session event. `install` wires it.
- ONE-SHOT (for sessions already running before the hook existed): `snap` also
  harvests a session id from a pane's scrollback when `/status` was run there.

Commands:
    agterm-backup install [--python PATH]
    agterm-backup status
    agterm-backup snap [--harvest]
    agterm-backup restore [--dry-run] [--yes]
"""
import sys
import os
import re
import json
import glob
import time
import argparse
import subprocess

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME, ".agterm-backup")
LIVE_DIR = os.path.join(STATE_DIR, "live")
SNAP_DIR = os.path.join(STATE_DIR, "snapshots")
LATEST = os.path.join(STATE_DIR, "snapshot.json")
SETTINGS = os.path.join(HOME, ".claude", "settings.json")
CODEX_CONFIG = os.path.join(HOME, ".codex", "config.toml")
CODEX_BEGIN = "# >>> agterm-backup capture hook (managed) >>>"
CODEX_END = "# <<< agterm-backup capture hook <<<"
AGENTS = ("claude", "codex")
WRAPPER = os.path.join(HOME, ".local", "bin", "agterm-backup")
PLIST = os.path.join(HOME, "Library", "LaunchAgents",
                     "dev.isachivka.agterm-backup-snap.plist")
LABEL = "dev.isachivka.agterm-backup-snap"
SNAP_LOG = os.path.join(STATE_DIR, "snap.log")
SELF = os.path.abspath(__file__)
GENERATED = "# generated by `agterm-backup timer install` — do not edit"
# realpath, not abspath: the command is normally invoked through the ~/.local/bin
# symlink, and abspath would resolve the skill directory to ~/.local/bin — where
# capture.py does not exist, quietly wiring the hooks to a missing file.
SKILL_DIR = os.path.dirname(os.path.realpath(__file__))
CAPTURE = os.path.join(SKILL_DIR, "capture.py")
PROJECTS = os.path.join(HOME, ".claude", "projects")

CAPTURE_EVENTS = ["SessionStart", "UserPromptSubmit", "PreToolUse", "Stop"]
UUID_RE = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                     r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")


# ----------------------------------------------------------------------------- util

def agtermctl(*args):
    """Run agtermctl, return parsed JSON (dict) or None on failure."""
    try:
        out = subprocess.run(["agtermctl", *args], capture_output=True,
                             text=True, timeout=15)
    except Exception:
        return None
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout)
    except Exception:
        return out.stdout


def slug(cwd):
    """Claude Code's project-dir slug: every non-alphanumeric char -> '-'."""
    return re.sub(r"[^a-zA-Z0-9]", "-", cwd)


def load_tree():
    d = agtermctl("tree", "--json")
    if isinstance(d, dict):
        return d.get("result", {}).get("tree", {})
    return {}


def iter_agent_panes(tree):
    """Yield (pane_uuid, role, cwd, workspace_name, title, flags, agent) for every pane
    currently running an agent (claude or codex), main and split."""
    for ws in tree.get("workspaces", []):
        wsname = ws.get("name")
        for s in ws.get("sessions", []):
            pid = (s.get("id") or "").upper()
            for role, fg, cwd in (
                ("left", s.get("foreground") or [], s.get("cwd") or ""),
                ("right", s.get("splitForeground") or [],
                 s.get("splitCwd") or s.get("cwd") or ""),
            ):
                agent = os.path.basename(fg[0]) if fg else ""
                if agent in AGENTS:
                    yield (pid, role, cwd, wsname, s.get("title") or "",
                           _flags(fg, agent), agent)


# kept for older call sites / muscle memory
def iter_claude_panes(tree):
    return iter_agent_panes(tree)


def all_panes(tree):
    """Every (pane_uuid, role, node) so restore can tell if a pane is at a shell."""
    out = {}
    for ws in tree.get("workspaces", []):
        for s in ws.get("sessions", []):
            pid = (s.get("id") or "").upper()
            out[(pid, "left")] = s.get("foreground") or []
            if s.get("split"):
                out[(pid, "right")] = s.get("splitForeground") or []
    return out


def norm_flags(flags, agent="claude"):
    """Flags minus anything that re-enters an existing session: claude's
    --resume/-r <id> (attached form included), --continue, --fork-session; codex's
    `resume`/`fork` subcommand with its id, and --last. restore supplies its own
    --resume, and claude honours the LAST one — a leftover would resume the wrong
    session, silently."""
    out = []
    skip = False
    for a in flags or []:
        if skip:
            skip = False
            continue
        if agent == "codex":
            if a in ("resume", "fork", "--last") or UUID_RE.fullmatch(a):
                continue
        else:
            if a in ("--resume", "-r"):
                skip = True
                continue
            if a.startswith("--resume=") or a.startswith("-r="):
                continue
            if a in ("--continue", "-c", "--fork-session"):
                continue
        out.append(a)
    return _dedupe(out)


def _dedupe(flags):
    """A pane can carry the same flag twice (a hand-typed resume on top of the original
    launch); do not pass that on."""
    seen, out = set(), []
    for f in flags:
        if f.startswith("-") and f in seen:
            continue
        seen.add(f)
        out.append(f)
    return out


def _flags(argv, agent="claude"):
    """The launch flags of a running agent, from its argv."""
    return norm_flags(list(argv[1:]), agent)


def live_for(live, pid, role, agent):
    """A pane's live record, but only when it was written by the agent running there
    now — a pane that ran claude yesterday and codex today must not resume the claude."""
    rec = live.get((pid, role))
    if rec and (rec.get("agent") or "claude") == agent:
        return rec
    return None


def resume_cmd(agent, sid, flags):
    """The shell line that puts an agent back into session `sid`."""
    if agent == "codex":
        return " ".join(["codex", "resume", sid] + list(flags))
    return " ".join(["claude", "--resume", sid] + list(flags))


def read_live():
    """pane_uuid|role -> live record (from the capture hook)."""
    out = {}
    for f in glob.glob(os.path.join(LIVE_DIR, "*.json")):
        try:
            with open(f) as fh:
                r = json.load(fh)
        except Exception:
            continue
        key = ((r.get("pane_uuid") or "").upper(), r.get("pane_role") or "left")
        out[key] = r
    return out


def harvest_scrollback(pane_uuid, cwd, agent="claude"):
    """Deterministic bonus: claude's `/status` prints 'Session ID: <uuid>', and codex
    prints 'codex resume <uuid>' when it exits. Accept an id only if its transcript
    exists on disk."""
    try:
        out = subprocess.run(["agtermctl", "session", "text", "--all",
                              "--target", pane_uuid], capture_output=True,
                             text=True, timeout=15)
    except Exception:
        return None
    if out.returncode != 0:
        return None
    if agent == "codex":
        ids = re.findall(r"codex resume ([0-9a-fA-F-]{36})", out.stdout)
        for cand in reversed(ids):
            if _codex_thread_exists(cand.lower()):
                return cand.lower()
        return None
    proj = os.path.join(PROJECTS, slug(cwd))
    # scan newest-first: last printed id wins
    ids = UUID_RE.findall(out.stdout)
    for cand in reversed(ids):
        if os.path.exists(os.path.join(proj, cand.lower() + ".jsonl")):
            return cand.lower()
    return None


def _codex_thread_exists(sid):
    """A codex thread lives as a rollout file named ...-<id>.jsonl under ~/.codex."""
    root = os.path.join(HOME, ".codex", "sessions")
    for hit in glob.glob(os.path.join(root, "*", "*", "*", "*%s.jsonl" % sid)):
        return True
    return False


# -------------------------------------------------------------------------- install

def cmd_install(args):
    os.makedirs(LIVE_DIR, exist_ok=True)
    os.makedirs(SNAP_DIR, exist_ok=True)
    py = args.python or "/usr/bin/python3"
    command = "%s %s" % (py, CAPTURE)

    try:
        with open(SETTINGS) as fh:
            cfg = json.load(fh)
    except FileNotFoundError:
        cfg = {}
    except Exception as e:
        print("ERROR: cannot read %s: %s" % (SETTINGS, e))
        return 1

    # back up before touching it
    if os.path.exists(SETTINGS):
        bak = SETTINGS + ".agterm-backup.bak"
        with open(SETTINGS) as a, open(bak, "w") as b:
            b.write(a.read())
        print("backed up settings -> %s" % bak)

    hooks = cfg.setdefault("hooks", {})
    added = []
    for event in CAPTURE_EVENTS:
        groups = hooks.setdefault(event, [])
        already = any(
            isinstance(h, dict) and "capture.py" in str(h.get("command", ""))
            for g in groups if isinstance(g, dict)
            for h in g.get("hooks", [])
        )
        if already:
            continue
        groups.append({"hooks": [{"type": "command", "command": command}]})
        added.append(event)

    with open(SETTINGS, "w") as fh:
        json.dump(cfg, fh, indent=2, ensure_ascii=False)
        fh.write("\n")

    if added:
        print("installed claude capture hook on: %s" % ", ".join(added))
    else:
        print("claude capture hook already installed on all events")
    print("command: %s" % command)
    _install_codex_hooks(py)
    _link_onto_path()
    print("\nNOTE: the hook fires on a session's NEXT event. Already-running "
          "sessions are captured when they next act (a prompt, a tool call, a turn "
          "end). Run 'agterm-backup status' to see coverage; 'agterm-backup snap' "
          "to also harvest ids from /status scrollback.")
    return 0


def _link_onto_path():
    """Put the command on PATH. It lives inside the skill directory, which nothing
    searches — and the one moment you reach for it is the moment after a crash, with
    no patience for hunting down a path."""
    target = os.path.join(HOME, ".local", "bin", "agterm-backup")
    src = os.path.join(SKILL_DIR, "agterm-backup")
    try:
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if os.path.islink(target) and os.path.realpath(target) == os.path.realpath(src):
            return
        if os.path.exists(target) and not os.path.islink(target):
            print("~/.local/bin/agterm-backup exists and is not a symlink — left alone")
            return
        if os.path.islink(target):
            os.unlink(target)
        # a symlink, not a copy: edits to the skill take effect with no reinstall
        os.symlink(src, target)
        print("linked %s -> %s" % (target, src))
    except Exception as e:
        print("could not link onto PATH (%s); run it by full path" % e)


def _codex_block(py):
    lines = [CODEX_BEGIN]
    for event in CAPTURE_EVENTS:
        lines += ["[[hooks.%s]]" % event,
                  "[[hooks.%s.hooks]]" % event,
                  'type = "command"',
                  'command = "%s %s codex"' % (py, CAPTURE),
                  ""]
    lines.append(CODEX_END)
    return "\n".join(lines) + "\n"


def _install_codex_hooks(py):
    """Codex fires the same events with the same payload, but is configured in TOML."""
    if not os.path.isdir(os.path.dirname(CODEX_CONFIG)):
        print("codex not installed (%s missing) — skipping codex hooks"
              % os.path.dirname(CODEX_CONFIG))
        return
    try:
        with open(CODEX_CONFIG) as fh:
            conf = fh.read()
    except FileNotFoundError:
        conf = ""
    if conf:
        with open(CODEX_CONFIG + ".agterm-backup.bak", "w") as fh:
            fh.write(conf)
    block = _codex_block(py)
    if CODEX_BEGIN in conf and CODEX_END in conf:
        head, rest = conf.split(CODEX_BEGIN, 1)
        conf = head + block + rest.split(CODEX_END, 1)[1].lstrip("\n")
        what = "updated"
    else:
        conf = conf.rstrip("\n") + "\n\n" + block
        what = "installed"
    with open(CODEX_CONFIG, "w") as fh:
        fh.write(conf)
    print("%s codex capture hook in %s" % (what, CODEX_CONFIG))
    print("  NOTE: codex asks you to trust changed hooks on its next start — pick "
          "\"Trust all and continue\" once, or the hook never runs.")


# --------------------------------------------------------- the resume prompt

RESUME_PROMPT = "Resume full session as-is"


def _pane_text(target, pane):
    try:
        out = subprocess.run(["agtermctl", "session", "text", "--target", target,
                              "--pane", pane], capture_output=True, text=True, timeout=15)
    except Exception:
        return ""
    return out.stdout if out.returncode == 0 else ""


def _waiting_on_prompt(text):
    """True only when the prompt is live at the bottom of the screen. Matching anywhere
    in the buffer is not enough: a pane that merely *talks about* the dialog (an agent
    quoting it) would be answered, typing a stray "2" into someone's session."""
    tail = "\n".join((text or "").rstrip().splitlines()[-14:])
    return (RESUME_PROMPT in tail
            and "Enter to confirm" in tail
            and "Resume from summary" in tail)


def answer_resume_prompts(targets, timeout=180, choice="2", quiet=False):
    """A resumed claude asks whether to replay the full session or a summary, and sits
    there until answered. Boot can take a minute, so poll rather than sleep-and-hope.

    `targets` is a list of (session_id, pane). Returns how many were answered."""
    pending = list(targets)
    answered = 0
    deadline = time.time() + timeout
    while pending and time.time() < deadline:
        time.sleep(3)
        for item in list(pending):
            sid, pane = item
            text = _pane_text(sid, pane)
            if not text:
                continue
            if _waiting_on_prompt(text):
                agtermctl("session", "type", "--target", sid, "--pane", pane,
                          choice + "\n")
                pending.remove(item)
                answered += 1
                if not quiet:
                    print("      answered the resume prompt in %s/%s" % (sid[:8], pane))
            elif "esc to interrupt" in text or "\u276f " in text:
                pending.remove(item)      # booted past the prompt, nothing to answer
    return answered


# ---------------------------------------------------------------------------- timer

def _launcher_path():
    """What the launchd job should exec.

    A job cannot point into the plugin cache — that path carries the commit sha and
    moves on every update. If ~/.local/bin/agterm-backup already exists, use it as it
    is: it is usually a symlink into a checkout, and writing through a symlink would
    overwrite the script it points at (this cost me one restore of this very file).
    Only when nothing is there do we generate a resolving wrapper.
    """
    if os.path.lexists(WRAPPER):
        return WRAPPER
    os.makedirs(os.path.dirname(WRAPPER), exist_ok=True)
    with open(WRAPPER, "w") as fh:
        fh.write(
            "#!/bin/sh\n" + GENERATED + "\n"
            'd=$(ls -dt "$HOME"/.claude/plugins/cache/*/bos/*/skills/agterm-backup '
            '2>/dev/null | head -1)\n'
            '[ -n "$d" ] && [ -f "$d/agterm-backup" ] || d=%s\n'
            'exec /usr/bin/python3 "$d/agterm-backup" "$@"\n' % json.dumps(os.path.dirname(SELF))
        )
    os.chmod(WRAPPER, 0o755)
    return WRAPPER


PLIST_TEMPLATE = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>%(label)s</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>%(launcher)s</string>
    <string>snap</string>
  </array>
  <key>StartInterval</key><integer>%(interval)d</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>%(log)s</string>
  <key>StandardErrorPath</key><string>%(log)s</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Applications/agterm.app/Contents/MacOS:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
"""


def cmd_timer(args):
    domain = "gui/%d" % os.getuid()
    if args.action == "status":
        loaded = subprocess.run(["launchctl", "list", LABEL], capture_output=True, text=True)
        print("plist    : %s" % ("present" if os.path.exists(PLIST) else "absent"))
        print("loaded   : %s" % ("yes" if loaded.returncode == 0 else "no"))
        if os.path.exists(LATEST):
            print("last snap: %ds ago" % int(time.time() - os.path.getmtime(LATEST)))
        return 0

    if args.action == "uninstall":
        subprocess.run(["launchctl", "bootout", "%s/%s" % (domain, LABEL)],
                       capture_output=True)
        if os.path.exists(PLIST):
            os.remove(PLIST)
        print("timer removed")
        return 0

    launcher = _launcher_path()
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    with open(PLIST, "w") as fh:
        fh.write(PLIST_TEMPLATE % {"label": LABEL, "launcher": launcher,
                                   "interval": args.interval, "log": SNAP_LOG})
    subprocess.run(["launchctl", "bootout", "%s/%s" % (domain, LABEL)], capture_output=True)
    boot = subprocess.run(["launchctl", "bootstrap", domain, PLIST],
                          capture_output=True, text=True)
    if boot.returncode:
        print("launchctl bootstrap failed: %s" % boot.stderr.strip(), file=sys.stderr)
        return 1
    print("runs    : /usr/bin/python3 %s snap" % launcher)
    print("plist   : %s" % PLIST)
    print("schedule: every %ds, and once at load" % args.interval)
    print("log     : %s" % SNAP_LOG)
    return 0


# --------------------------------------------------------------------------- status

def cmd_status(args):
    tree = load_tree()
    live = read_live()
    panes = list(iter_agent_panes(tree))
    hook_ok = _hook_installed()

    print("claude hook    : %s" % ("yes" if hook_ok else "NO — run: agterm-backup install"))
    print("codex hook     : %s" % ("yes" if _codex_hook_installed()
                                   else "no  — run: agterm-backup install"))
    print("live captures  : %d file(s) in %s" % (len(live), LIVE_DIR))
    age = "-"
    if os.path.exists(LATEST):
        age = "%ds ago" % int(time.time() - os.path.getmtime(LATEST))
    print("last snapshot  : %s" % age)
    print()
    print("running agent panes: %d" % len(panes))
    print("  %-10s %-6s %-7s %-26s %-8s %s"
          % ("pane", "role", "agent", "cwd", "state", "session id"))
    missing = 0
    for pid, role, cwd, wsname, title, flags, agent in panes:
        rec = live_for(live, pid, role, agent)
        if rec:
            sid = rec["claude_session_id"][:8] + "…  (hook)"
        else:
            sid = "— not captured —"
            missing += 1
        print("  %-10s %-6s %-7s %-26s %-8s %s"
              % (pid[:8], role, agent, cwd[:26], wsname or "?", sid))
    if missing:
        print("\n%d pane(s) not yet captured. They register on their next activity, "
              "or run 'agterm-backup snap --harvest' to try scrollback (needs /status "
              "to have been run there)." % missing)
    return 0


def _codex_hook_installed():
    try:
        with open(CODEX_CONFIG) as fh:
            return CODEX_BEGIN in fh.read()
    except Exception:
        return False


def _hook_installed():
    try:
        with open(SETTINGS) as fh:
            cfg = json.load(fh)
    except Exception:
        return False
    for groups in cfg.get("hooks", {}).values():
        for g in groups if isinstance(groups, list) else []:
            if not isinstance(g, dict):
                continue
            for h in g.get("hooks", []):
                if "capture.py" in str(h.get("command", "")):
                    return True
    return False


# ----------------------------------------------------------------------------- snap

def cmd_snap(args):
    os.makedirs(SNAP_DIR, exist_ok=True)
    tree = load_tree()
    windows = agtermctl("window", "list", "--json")
    live = read_live()

    panes = []
    for pid, role, cwd, wsname, title, flags, agent in iter_agent_panes(tree):
        rec = live_for(live, pid, role, agent)
        sid = rec["claude_session_id"] if rec else None
        source = "hook" if rec else None
        if not sid and args.harvest:
            sid = harvest_scrollback(pid, cwd, agent)
            source = "scrollback" if sid else None
        panes.append({
            "pane_uuid": pid, "pane_role": role, "workspace_name": wsname,
            "cwd": cwd, "session_title": title, "resume_flags": flags, "agent": agent,
            "claude_session_id": sid, "id_source": source,
        })

    snap = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "agterm_version": _agterm_version(),
        "tree": tree,
        "windows": windows,
        "panes": panes,
    }
    stamp = time.strftime("%Y%m%d-%H%M%S", time.gmtime())
    path = os.path.join(SNAP_DIR, stamp + ".json")
    with open(path, "w") as fh:
        json.dump(snap, fh, indent=1)
    with open(LATEST, "w") as fh:
        json.dump(snap, fh, indent=1)
    _prune_snapshots(keep=20)

    got = sum(1 for p in panes if p["claude_session_id"])
    print("snapshot -> %s" % path)
    print("claude panes: %d, with session id: %d, missing: %d"
          % (len(panes), got, len(panes) - got))
    for p in panes:
        mark = p["id_source"] or "MISSING"
        sid = (p["claude_session_id"] or "")[:8]
        print("  %-10s %-6s %-24s %-10s %s"
              % (p["pane_uuid"][:8], p["pane_role"], p["cwd"][:24], mark, sid))
    return 0


def _agterm_version():
    try:
        out = subprocess.run(["agtermctl", "--help"], capture_output=True, text=True)
        # version isn't exposed by agtermctl; read the app bundle
        p = "/Applications/agterm.app/Contents/Info.plist"
        v = subprocess.run(["plutil", "-extract", "CFBundleShortVersionString",
                            "raw", p], capture_output=True, text=True)
        return v.stdout.strip() or None
    except Exception:
        return None


def _prune_snapshots(keep=20):
    files = sorted(glob.glob(os.path.join(SNAP_DIR, "*.json")))
    for f in files[:-keep]:
        try:
            os.unlink(f)
        except Exception:
            pass


# -------------------------------------------------------------------------- restore

def _tree_panes(tree):
    """(pane_uuid, role) -> {workspace_name, title, cwd, foreground} for the tree as
    it stands right now."""
    out = {}
    for ws in tree.get("workspaces", []):
        for sn in ws.get("sessions", []):
            pid = (sn.get("id") or "").upper()
            out[(pid, "left")] = {
                "workspace_name": ws.get("name"), "title": sn.get("title") or "",
                "cwd": sn.get("cwd") or "", "foreground": sn.get("foreground") or [],
            }
            if sn.get("split"):
                out[(pid, "right")] = {
                    "workspace_name": ws.get("name"), "title": sn.get("title") or "",
                    "cwd": sn.get("splitCwd") or sn.get("cwd") or "",
                    "foreground": sn.get("splitForeground") or [],
                }
    return out


def collect_records():
    """(pane_uuid, role) -> what to resume there.

    The hook captures are the source of truth: they are written continuously, so
    they survive a crash with no warning and no `snap`. The saved snapshot only
    fills gaps — panes it harvested from scrollback, and flags for records written
    before capture.py recorded them. A snapshot id NEVER overrides a live one; a
    stale snapshot resuming week-old sessions is exactly the failure this avoids."""
    recs = {}
    for (pid, role), r in read_live().items():
        agent = r.get("agent") or "claude"
        recs[(pid, role)] = {
            "pane_uuid": pid, "pane_role": role, "agent": agent,
            "claude_session_id": r.get("claude_session_id"),
            "transcript_path": r.get("transcript_path") or "",
            "cwd": r.get("cwd") or "",
            "resume_flags": norm_flags(r.get("resume_flags") or [], agent),
            "ts": r.get("ts") or "", "id_source": "hook",
        }

    if os.path.exists(LATEST):
        try:
            with open(LATEST) as fh:
                snap = json.load(fh)
        except Exception:
            snap = {"panes": []}
        for p in snap.get("panes", []):
            key = ((p.get("pane_uuid") or "").upper(), p.get("pane_role") or "left")
            agent = p.get("agent") or "claude"
            flags = norm_flags(p.get("resume_flags") or [], agent)
            cur = recs.get(key)
            if cur is None:
                if not p.get("claude_session_id"):
                    continue
                recs[key] = {
                    "pane_uuid": key[0], "pane_role": key[1], "agent": agent,
                    "claude_session_id": p["claude_session_id"],
                    "transcript_path": "", "cwd": p.get("cwd") or "",
                    "resume_flags": flags, "ts": snap.get("ts") or "",
                    "id_source": p.get("id_source") or "snapshot",
                }
            elif not cur["resume_flags"] and flags and cur["agent"] == agent:
                cur["resume_flags"] = flags
    return recs


def cmd_restore(args):
    if getattr(args, "from_live", False):
        print("note: --from-live is the default now; the flag does nothing.\n")

    recs = collect_records()
    tree = load_tree()
    panes = _tree_panes(tree)

    plan = []
    for key, r in recs.items():
        meta = panes.get(key)
        if meta is None:
            plan.append((r, None, None, "SKIP: pane no longer in the tree"))
            continue
        sid = r.get("claude_session_id")
        if not sid:
            plan.append((r, meta, None, "SKIP: no session id captured"))
            continue
        fg = meta["foreground"]
        if fg and os.path.basename(fg[0]) in AGENTS:
            plan.append((r, meta, None,
                         "SKIP: %s already running here" % os.path.basename(fg[0])))
            continue
        tp = r.get("transcript_path")
        if tp and not os.path.exists(tp):
            plan.append((r, meta, None, "SKIP: transcript gone from disk"))
            continue
        plan.append((r, meta, resume_cmd(r["agent"], sid, r["resume_flags"]), "inject"))

    def label(r, meta):
        ws = (meta or {}).get("workspace_name") or "?"
        title = (meta or {}).get("title") or ""
        return "%s/%s" % (ws, title[:34] or r["pane_uuid"][:8])

    plan.sort(key=lambda e: (label(e[0], e[1]).lower(), e[0]["pane_role"]))
    inject = [(r, meta, cmd) for r, meta, cmd, note in plan if cmd]
    # A pane that no longer exists is the normal residue of closed sessions, not a
    # problem to read through: live records outlive their panes (and an archived
    # workspace can bring one back), so they are counted, not listed.
    gone = sum(1 for r, meta, cmd, note in plan if meta is None)
    skipped = [(r, meta, note) for r, meta, cmd, note in plan
               if not cmd and meta is not None]

    print("Restore plan — %d to resume, %d skipped:\n" % (len(inject), len(skipped)))
    for r, meta, cmd in inject:
        print("  [resume] %-42s %-5s %s" % (label(r, meta), r["pane_role"], cmd))
    if skipped:
        print("")
        for r, meta, note in skipped:
            print("  [ skip ] %-42s %-5s %s" % (label(r, meta), r["pane_role"], note))
    if gone:
        print("\n  (%d record(s) for panes that no longer exist — ignored)" % gone)

    if args.dry_run:
        print("\n--dry-run: nothing typed.")
        return 0
    if not inject:
        print("\nnothing to resume.")
        return 0
    if not args.yes:
        try:
            ans = input("\nResume %d session(s)? [y/N] " % len(inject))
        except EOFError:
            ans = ""
        if ans.strip().lower() not in ("y", "yes"):
            print("aborted.")
            return 0

    failed = 0
    for r, meta, cmd in inject:
        typ = ["agtermctl", "session", "type", cmd + "\n", "--target", r["pane_uuid"]]
        if r["pane_role"] == "right":
            typ += ["--pane", "right"]
        try:
            subprocess.run(typ, timeout=15, check=True)
        except Exception as e:
            failed += 1
            print("  failed on %s: %s" % (label(r, meta), e))
    print("done: resumed %d%s." % (len(inject) - failed,
                                   (", %d failed" % failed) if failed else ""))

    if not args.no_answer:
        targets = [(r["pane_uuid"], "right" if r["pane_role"] == "right" else "left")
                   for r, _m, _c in inject]
        print("\nwatching for the resume prompt (up to %ds; claude can take a minute "
              "to boot)..." % args.answer_timeout)
        n = answer_resume_prompts(targets, timeout=args.answer_timeout,
                                  choice=args.answer_choice)
        print("answered %d resume prompt(s) with %r." % (n, args.answer_choice))
    return 0


def cmd_answer(args):
    """Answer the resume prompt anywhere it is waiting — after a restore that ran
    without --no-answer this is a no-op, but a manual `claude --resume` leaves them too."""
    tree = load_tree()
    targets = []
    for ws in tree.get("workspaces", []):
        for s in ws.get("sessions", []):
            pid = (s.get("id") or "").upper()
            for role, fg in (("left", s.get("foreground") or []),
                             ("right", s.get("splitForeground") or [])):
                if fg and os.path.basename(fg[0]) == "claude":
                    targets.append((pid, role))
    if args.target:
        want = args.target.upper()
        targets = [t for t in targets if t[0].startswith(want)]
    me = (os.environ.get("AGTERM_SESSION_ID") or "").upper()
    mine = (os.environ.get("AGTERM_PANE") or "left")
    waiting = [(sid, pane) for sid, pane in targets
               if not (sid.upper() == me and pane == mine)
               and _waiting_on_prompt(_pane_text(sid, pane))]
    print("claude panes: %d, sitting on the resume prompt: %d" % (len(targets), len(waiting)))
    if not waiting:
        return 0
    if args.dry_run:
        for sid, pane in waiting:
            print("  would answer %r in %s/%s" % (args.answer_choice, sid[:8], pane))
        return 0
    n = answer_resume_prompts(waiting, timeout=args.answer_timeout,
                              choice=args.answer_choice)
    print("answered %d." % n)
    return 0


# ------------------------------------------------------------------------------ main

def main():
    ap = argparse.ArgumentParser(prog="agterm-backup")
    sub = ap.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("install", help="wire the capture hook + create state dirs")
    pi.add_argument("--python", help="python interpreter for the hook (default /usr/bin/python3)")
    pi.set_defaults(func=cmd_install)

    ps = sub.add_parser("status", help="show capture coverage for running claude panes")
    ps.set_defaults(func=cmd_status)

    pn = sub.add_parser("snap", help="write a snapshot (claude ids + topology)")
    pn.add_argument("--harvest", action="store_true",
                    help="also try to read ids from /status scrollback for uncaptured panes")
    pn.set_defaults(func=cmd_snap)

    pr = sub.add_parser("restore", help="resume every captured session in its pane")
    pr.add_argument("--dry-run", action="store_true")
    pr.add_argument("--yes", action="store_true")
    pr.add_argument("--from-live", action="store_true", help=argparse.SUPPRESS)
    pr.add_argument("--no-answer", action="store_true",
                    help="do not answer claude's resume prompt afterwards")
    pr.add_argument("--answer-choice", default="2",
                    help="2 = resume full session as-is (default), 1 = from summary")
    pr.add_argument("--answer-timeout", type=int, default=240,
                    help="how long to keep watching for the prompt (default 240s)")
    pr.set_defaults(func=cmd_restore)

    pt = sub.add_parser("timer", help="run `snap` on a launchd schedule")
    pt.add_argument("action", choices=["install", "uninstall", "status"])
    pt.add_argument("--interval", type=int, default=900, help="seconds (default 900)")
    pt.set_defaults(func=cmd_timer)

    pa = sub.add_parser("answer", help="answer the resume prompt wherever it is waiting")
    pa.add_argument("--target", help="only this session id/prefix")
    pa.add_argument("--answer-choice", default="2",
                    help="2 = resume full session as-is (default), 1 = from summary")
    pa.add_argument("--answer-timeout", type=int, default=60)
    pa.add_argument("--dry-run", action="store_true")
    pa.set_defaults(func=cmd_answer)

    args = ap.parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
