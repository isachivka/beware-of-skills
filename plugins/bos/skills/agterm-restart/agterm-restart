#!/usr/bin/env python3
"""agterm-restart — restart every Claude Code running in agterm, in place, resumed.

For each pane running claude: Ctrl+C until claude exits, read the
"claude --resume <id>" line it prints on exit, then type that resume back into
the same pane with the original launch flags. Picks up a new binary, new
settings.json env, new MCP config — without losing any conversation.
"""
import argparse
import importlib.machinery
import json
import os
import re
import shlex
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
KEYMAP = os.path.join(HOME, ".config", "agterm", "keymap.conf")
WRAPPER = os.path.join(HOME, ".local", "bin", "agterm-restart")
BEGIN = "# >>> agterm-restart (generated by `agterm-restart install` — do not edit) >>>"
END = "# <<< agterm-restart <<<"
DEFAULT_CHORD = "cmd+ctrl+a>c"

SKILL_DIR = os.path.dirname(os.path.realpath(__file__))
_fork = importlib.machinery.SourceFileLoader(
    "agterm_fork", os.path.join(SKILL_DIR, "..", "agterm-fork", "agterm-fork")).load_module()
AGTERMCTL = _fork.AGTERMCTL
SOCKET_OPT = (("--socket", os.environ.get("AGT_SOCKET") or os.environ["AGTERM_SOCKET"])
              if (os.environ.get("AGT_SOCKET") or os.environ.get("AGTERM_SOCKET")) else ())

RESUME_RE = re.compile(r"claude (?:--resume|-r) ([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                       r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12})")
CTRL_C = "\x03"
# claude's input line: the prompt glyph then a space, which it renders as a NBSP
READY_RE = re.compile(r"^\u276f[ \xa0]", re.M)


def ctl(*args, check=True):
    out = subprocess.run([AGTERMCTL, *args, *SOCKET_OPT], capture_output=True, text=True,
                         timeout=15)
    if check and out.returncode != 0:
        raise RuntimeError("agtermctl %s: %s" % (" ".join(args[:2]), out.stderr.strip()))
    return out.stdout


def claude_argv(argv):
    """The claude command line a pane runs, or None.

    Either claude itself (`claude --flags`, or a versioned binary path), or a
    `zsh -lc 'claude --flags "$(cat brief)"; exec zsh -l'` wrapper that agents
    launch sessions with — then the claude part of the -c string is used.
    """
    if not argv:
        return None
    if os.path.basename(argv[0]) == "claude" or "/claude/versions/" in argv[0]:
        return ["claude", *argv[1:]]
    if os.path.basename(argv[0]) in ("zsh", "bash", "sh") and len(argv) >= 3 \
            and argv[1] in ("-c", "-lc", "-ic"):
        first = re.split(r";|&&|\|\|", argv[2], maxsplit=1)[0]
        try:
            words = shlex.split(first)
        except ValueError:
            return None
        if words and os.path.basename(words[0]) == "claude":
            return words
    return None


def resume_cmd(argv, sid):
    """`claude --resume <sid> <original flags>`, prompts and old resume ids dropped."""
    flags = _fork.drop_positionals(_fork.strip_resume(argv, "claude"), "claude")
    return " ".join(shlex.quote(t) for t in ["claude", "--resume", sid, *flags])


def resume_id_from_screen(text):
    found = RESUME_RE.findall(text or "")
    return found[-1] if found else None


def collect(include_busy):
    """(window, session, pane, argv, label) for every claude pane, plus skip notes."""
    # only a run from inside a claude (its Bash tool sets CLAUDECODE) would kill itself;
    # the palette overlay carries AGTERM_SESSION_ID too, and there it must not skip
    me = (os.environ.get("AGTERM_SESSION_ID") or "").upper() if os.environ.get("CLAUDECODE") else ""
    my_pane = os.environ.get("AGTERM_PANE") or "left"
    windows = json.loads(ctl("window", "list", "--json"))["result"]["windows"]
    targets, skipped = [], []
    for w in windows:
        if w.get("closed"):
            continue
        tree = json.loads(ctl("tree", "--json", "--window", w["id"]))["result"]["tree"]
        for ws in tree.get("workspaces", []):
            for s in ws.get("sessions", []):
                panes = [("left", s.get("foreground"))]
                if s.get("hasSplit"):
                    panes.append(("right", s.get("splitForeground")))
                for pane, fg in panes:
                    argv = claude_argv(fg)
                    if not argv:
                        continue
                    label = "%s / %s%s" % (ws.get("name") or "?", s.get("name") or s["id"][:8],
                                           "" if pane == "left" else " [split]")
                    if s["id"].upper() == me and pane == my_pane:
                        skipped.append((label, "this session — restart it by hand"))
                    elif s.get("status") == "active" and s.get("statusPane", "left") == pane \
                            and not include_busy:
                        skipped.append((label, "busy (status active) — --busy to include"))
                    else:
                        targets.append({"window": w["id"], "sid": s["id"], "pane": pane,
                                        "argv": argv, "label": label})
    return targets, skipped


def pane_state(t):
    tree = json.loads(ctl("tree", "--json", "--window", t["window"]))["result"]["tree"]
    for ws in tree.get("workspaces", []):
        for s in ws.get("sessions", []):
            if s["id"] == t["sid"]:
                return s.get("foreground" if t["pane"] == "left" else "splitForeground")
    return None


def screen(t, lines=60):
    return ctl("session", "text", "--target", t["sid"], "--window", t["window"],
               "--pane", t["pane"], "--lines", str(lines), check=False)


def type_into(t, text):
    ctl("session", "type", "--target", t["sid"], "--window", t["window"],
        "--pane", t["pane"], text)


def stop(t, timeout):
    """Ctrl+C until claude is gone. The first press may interrupt a turn or clear a
    drafted prompt, the next arms "press Ctrl-C again to exit", the one after exits."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not claude_argv(pane_state(t)):
            return True
        type_into(t, CTRL_C)
        time.sleep(0.4)
        type_into(t, CTRL_C)
        for _ in range(10):
            time.sleep(0.5)
            if not claude_argv(pane_state(t)):
                return True
    return False


def answer_resume_prompts(started, timeout, choice):
    """A resumed claude may ask full-session-vs-summary before reaching its prompt."""
    pending = list(started)
    deadline = time.time() + timeout
    while pending and time.time() < deadline:
        time.sleep(3)
        for t in list(pending):
            text = screen(t, 30)
            tail = "\n".join(text.rstrip().splitlines()[-14:])
            if "Resume full session as-is" in tail and "Enter to confirm" in tail:
                type_into(t, choice + "\n")
                print("  %s: answered the resume prompt with %s" % (t["label"], choice), flush=True)
                pending.remove(t)
            elif READY_RE.search(tail) or "esc to interrupt" in text:
                pending.remove(t)
        if pending:
            print("  %d still booting…" % len(pending), flush=True)
    for t in pending:
        print("  %s: not at its prompt after %ds — check it" % (t["label"], timeout))


def cmd_run(args):
    targets, skipped = collect(args.busy)
    if args.match:
        targets = [t for t in targets if args.match.lower() in t["label"].lower()]
    for label, why in skipped:
        print("skip  %s  (%s)" % (label, why))
    if not targets:
        print("no claude sessions to restart")
        return 0
    if args.dry_run:
        for t in targets:
            print("would restart  %s\n    %s" % (t["label"], resume_cmd(t["argv"], "<id>").replace("'<id>'", "<id>")))
        return 0

    failed, started = [], []
    for t in targets:
        if not stop(t, args.stop_timeout):
            failed.append((t["label"], "claude did not exit after Ctrl+C"))
            continue
        time.sleep(0.5)
        sid = resume_id_from_screen(screen(t)) or _fork.resume_id(t["argv"])
        if not sid:
            failed.append((t["label"], "no 'claude --resume <id>' on screen — left at the shell"))
            continue
        cmd = resume_cmd(t["argv"], sid)
        type_into(t, cmd + "\n")
        started.append(t)
        print("restart  %s\n    %s" % (t["label"], cmd), flush=True)

    if started and args.answer_choice != "none":
        print("\nwaiting for resume prompts…", flush=True)
        answer_resume_prompts(started, args.answer_timeout, args.answer_choice)
    for label, why in failed:
        print("FAILED  %s: %s" % (label, why))
    print("\nrestarted %d, skipped %d, failed %d" % (len(started), len(skipped), len(failed)))
    return 1 if failed else 0


def cmd_install(args):
    """Palette entry: a keymap child has no terminal, so the wrapper re-runs the script
    in an overlay on the session the command fired from, where the run is visible and
    held open (--wait) until a key is pressed."""
    os.makedirs(os.path.dirname(WRAPPER), exist_ok=True)
    with open(WRAPPER, "w") as fh:
        fh.write(
            "#!/bin/sh\n"
            "# generated by `agterm-restart install` — do not edit\n"
            'PATH="/opt/homebrew/bin:/usr/local/bin:%s:$PATH"; export PATH\n'
            'd=$(ls -dt "$HOME"/.claude/plugins/cache/*/bos/*/skills/agterm-restart '
            '2>/dev/null | head -1)\n'
            '[ -n "$d" ] && [ -f "$d/agterm-restart" ] || d=%s\n'
            'if [ -t 1 ]; then exec /usr/bin/python3 "$d/agterm-restart" "$@"; fi\n'
            'exec agtermctl session overlay open "$0 $*" --wait --size-percent 80 '
            '${AGT_SESSION_ID:+--target "$AGT_SESSION_ID"} ${AGT_SOCKET:+--socket "$AGT_SOCKET"}\n'
            % (os.path.dirname(_fork.BUNDLED_AGTERMCTL), json.dumps(SKILL_DIR)))
    os.chmod(WRAPPER, 0o755)

    chord = "" if args.no_chord else (args.chord or DEFAULT_CHORD) + " "
    block = '%s\ncommand "Restart claude sessions" %s%s\n%s\n' % (
        BEGIN, chord, WRAPPER.replace(HOME, "$HOME"), END)
    try:
        with open(KEYMAP) as fh:
            conf = fh.read()
    except FileNotFoundError:
        conf = ""
    if BEGIN in conf and END in conf:
        head, rest = conf.split(BEGIN, 1)
        conf = head + block + rest.split(END, 1)[1].lstrip("\n")
    else:
        conf = conf.rstrip("\n") + "\n\n" + block
    os.makedirs(os.path.dirname(KEYMAP), exist_ok=True)
    with open(KEYMAP, "w") as fh:
        fh.write(conf)
    print(ctl("keymap", "reload").strip() or "keymap reloaded")
    print("wrapper:  %s" % WRAPPER)
    print('palette:  Ctrl-Shift-O -> "Restart claude sessions"%s' %
          ("" if args.no_chord else "   (chord: %s)" % (args.chord or DEFAULT_CHORD)))
    return 0


def cmd_uninstall(args):
    try:
        with open(KEYMAP) as fh:
            conf = fh.read()
    except FileNotFoundError:
        conf = ""
    if BEGIN in conf and END in conf:
        head, rest = conf.split(BEGIN, 1)
        with open(KEYMAP, "w") as fh:
            fh.write(head.rstrip("\n") + "\n" + rest.split(END, 1)[1].lstrip("\n"))
        ctl("keymap", "reload")
        print("removed the keymap block, keymap reloaded")
    if os.path.exists(WRAPPER):
        os.remove(WRAPPER)
        print("removed %s" % WRAPPER)
    return 0


def main():
    ap = argparse.ArgumentParser(prog="agterm-restart", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    r = sub.add_parser("run", help="restart the claude sessions (default command)")
    r.add_argument("--dry-run", action="store_true", help="list what would restart")
    r.add_argument("--busy", action="store_true",
                   help="also restart sessions whose status is active (interrupts the turn)")
    r.add_argument("--match", help="only sessions whose 'workspace / name' contains this")
    r.add_argument("--stop-timeout", type=int, default=20)
    r.add_argument("--answer-timeout", type=int, default=240)
    r.add_argument("--answer-choice", default="2",
                   help="resume prompt: 2 = full session as-is (default), 1 = from summary, "
                        "none = leave it")
    r.set_defaults(fn=cmd_run)
    i = sub.add_parser("install", help='add "Restart claude sessions" to the agterm palette')
    i.add_argument("--chord", help="key chord (default: %s)" % DEFAULT_CHORD)
    i.add_argument("--no-chord", action="store_true", help="palette-only, no key binding")
    i.set_defaults(fn=cmd_install)
    u = sub.add_parser("uninstall", help="remove the palette entry and wrapper")
    u.set_defaults(fn=cmd_uninstall)

    argv = sys.argv[1:]
    if not argv or argv[0] not in ("run", "install", "uninstall", "-h", "--help"):
        argv = ["run"] + argv
    args = ap.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main())
